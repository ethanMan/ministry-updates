---
import { site } from '~/config';

const { email, instagram, facebook } = site.contact;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p style="margin:0">© {year} {site.name}</p>

    <div class="footer-links">
      {email && <a href={`mailto:${email}`}>Email</a>}
      {instagram && <a href={instagram} rel="me noopener">Instagram</a>}
      {facebook && <a href={facebook} rel="me noopener">Facebook</a>}
      {/*
        The RSS link is hidden for now — clicking it just shows raw XML, which
        looks broken to anyone who doesn't already use a feed reader. The feed
        itself is still built and still announced in the <head> of every page
        (see BaseLayout.astro), so feed readers can find it on their own.
        Uncomment this when there's someone who'd actually use it — and bring
        back `import { withBase } from '~/lib/url';` above when you do.

        <a href={withBase('/rss.xml')}>RSS</a>
      */}
    </div>
  </div>
</footer>
