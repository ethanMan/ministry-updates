---
import { Image } from 'astro:assets';
import { formatDate, type Newsletter } from '~/lib/newsletters';
import { withBase } from '~/lib/url';

interface Props {
  entry: Newsletter;
}

const { entry } = Astro.props;
const { title, date, summary, cover, coverAlt } = entry.data;
const href = withBase(`/newsletters/${entry.id}`);
---

<li class="card">
  {
    cover && (
      <div class="card__media">
        {/* Cards are ~360px wide on desktop and full width on a phone; the
            larger widths are what keep them sharp on 2x screens. */}
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          width={720}
          widths={[360, 520, 720, 1080]}
          sizes="(max-width: 760px) calc(100vw - 2.5rem), 360px"
          loading="lazy"
        />
      </div>
    )
  }

  <div class="card__body">
    <p class="card__date">{formatDate(date)}</p>
    <h3 class="card__title"><a href={href}>{title}</a></h3>
    <p class="card__summary">{summary}</p>
  </div>
</li>
