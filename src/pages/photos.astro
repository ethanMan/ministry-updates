---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PhotoGrid from '~/components/PhotoGrid.astro';
import { getPhotos, packIntoRows } from '~/lib/photos';

const photos = await getPhotos();
const rows = packIntoRows(photos);
---

<BaseLayout
  title="Photos"
  description="Moments from along the way, newest first."
>
  <header class="photos__header">
    <h1>Photos</h1>
    <p>Moments from along the way, newest first. Click any photo to see it larger.</p>
  </header>

  {
    photos.length === 0 ? (
      <div class="empty">
        <p>
          <strong>Nothing here yet.</strong>
        </p>
        <p>
          Add photos to <code>src/content/photos/</code> and list them in{' '}
          <code>photos.yaml</code> to fill this page.
        </p>
      </div>
    ) : (
      <PhotoGrid rows={rows} />
    )
  }
</BaseLayout>
