---
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Signature from '~/components/Signature.astro';
import { site } from '~/config';
import { withBase } from '~/lib/url';

const portraitFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portrait.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const portrait = Object.values(portraitFiles)[0]?.default;
---

<BaseLayout title="About" description={`About ${site.name}.`}>
  <article class="article">
    <header class="article__header">
      <h1>About me</h1>
      <p class="article__summary">A little about who I am and what I am doing here.</p>
    </header>

    {
      portrait && (
        <Image
          class="about__portrait"
          src={portrait}
          alt={site.portraitAlt}
          width={576}
          widths={[288, 576, 864]}
          sizes="(max-width: 400px) calc(100vw - 2.5rem), 288px"
          loading="eager"
        />
      )
    }

    <div class="prose">
      {/* Replace everything below with your own story. */}
      <p>
        Hello! Thank you for visiting this site! I'm Ethan, and this is where I write to
        the people who pray for and support me.
      </p>

      <h2>How I got here</h2>
      <p>
        Write a few paragraphs about how you came to this work, the people you are with,
        and what you are praying toward. It does not need to be polished — the people
        reading it already know you.
      </p>

      <h2>My vision</h2>
      <p>
        God has blessed me with a unique story, saving me from a darkness that many college students find themselves in now. God has blessed me with a desire to reach them in His name, winning them to Christ, building them as disciples, and sending them beyond to fulfill the Great Commission and live as faithful disciples wherever they go.
      </p>

      <h2>What I am asking prayer for</h2>
      <p>
        List the things you would most like your partners praying over. In my experience
        this is the section people come back to.
      </p>

      <h2>Staying in touch</h2>
      <p>
        I post new updates on the <a href={withBase('/updates')}>updates page</a>.
        Bookmark it, or pass the link along to anyone who wants to follow along.
      </p>

      {
        site.contact.email && (
          <p>
            You can also write to me directly at{' '}
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
          </p>
        )
      }

      <Signature />
    </div>
  </article>
</BaseLayout>
