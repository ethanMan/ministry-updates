---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterCard from '~/components/NewsletterCard.astro';
import { site } from '~/config';
import { getPublishedNewsletters } from '~/lib/newsletters';
import { withBase } from '~/lib/url';

const all = await getPublishedNewsletters();
const recent = all.slice(0, 6);
const latest = all[0];
---

<BaseLayout>
  <section class="hero">
    <h1>{site.tagline}</h1>
    <p>{site.description}</p>

    <div class="hero__actions">
      {
        latest && (
          <a class="btn" href={withBase(`/newsletters/${latest.id}`)}>
            Read the latest update
          </a>
        )
      }
      {
        all.length > 1 && (
          <a class="btn btn--ghost" href={withBase('/newsletters')}>
            Browse all newsletters
          </a>
        )
      }
    </div>
  </section>

  {
    recent.length > 0 ? (
      <section>
        <h2 class="section-label">Recent updates</h2>
        <ul class="card-grid">
          {recent.map((entry) => (
            <NewsletterCard entry={entry} />
          ))}
        </ul>
      </section>
    ) : (
      <div class="empty">
        <p><strong>No newsletters published yet.</strong></p>
        <p>
          Add a markdown file to <code>src/content/newsletters/</code> and it will show up
          here automatically.
        </p>
      </div>
    )
  }

  {
    site.givingUrl && (
      <aside class="callout">
        <h2>{site.givingLabel}</h2>
        <p>
          Thank you for standing with us. Your partnership in prayer and giving is what
          makes this ministry possible.
        </p>
        <a class="btn" href={site.givingUrl} rel="noopener">
          {site.givingLabel}
        </a>
      </aside>
    )
  }
</BaseLayout>
