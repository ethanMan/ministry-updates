---
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import UpdateCard from '~/components/UpdateCard.astro';
import Signature from '~/components/Signature.astro';
import { site } from '~/config';
import { getPublishedUpdates } from '~/lib/updates';
import { withBase } from '~/lib/url';

const all = await getPublishedUpdates();
const recent = all.slice(0, 6);

// Matched as a pattern rather than imported directly, so the banner can be a
// .jpg, .png or .webp — and so deleting the file simply hides it instead of
// breaking the build.
const bannerFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/home-banner.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const banner = Object.values(bannerFiles)[0]?.default;

// Same pattern for the portrait beside the note below.
const portraitFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portrait.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const portrait = Object.values(portraitFiles)[0]?.default;
---

<BaseLayout image={banner?.src} flush={Boolean(banner)}>
  <section class:list={['hero', banner && 'hero--banner']} slot="full-width">
    {
      banner && (
        <>
          <Image
            class="hero__image"
            src={banner}
            alt={site.bannerAlt}
            width={1600}
            widths={[640, 960, 1280, 1600, 2000, 2400]}
            sizes="100vw"
            loading="eager"
          />
          {/* Fades the photo into the page colour so the words stay readable. */}
          <div class="hero__scrim" />
        </>
      )
    }

    <div class="hero__content">
      <h1>{site.homeHeading}</h1>
      <p>{site.description}</p>
    </div>
  </section>

  {/* A short note in your own voice, the way a letter opens. */}
  <div class="column">
    <section class:list={['letter', !portrait && 'letter--no-portrait']}>
      {
        portrait && (
          <Image
            class="letter__portrait"
            src={portrait}
            alt={site.portraitAlt}
            width={176}
            densities={[1, 2]}
            loading="eager"
          />
        )
      }

      <div>
        {site.greeting && <p class="letter__greeting">{site.greeting}</p>}
        <p>{site.intro}</p>
        <Signature />
      </div>
    </section>
  </div>

  {
    recent.length > 0 ? (
      <section class="column">
        <h2 class="section-label">Recent updates</h2>
        <ul class="entry-list">
          {recent.map((entry) => (
            <UpdateCard entry={entry} />
          ))}
        </ul>

        {all.length > recent.length && (
          <p style="margin-top: 2rem">
            <a class="link-more" href={withBase('/updates')}>
              Every update
            </a>
          </p>
        )}
      </section>
    ) : (
      <div class="empty column">
        <p><strong>No updates published yet.</strong></p>
        <p>
          Add a markdown file to <code>src/content/updates/</code> and it will show up
          here automatically.
        </p>
      </div>
    )
  }
</BaseLayout>
