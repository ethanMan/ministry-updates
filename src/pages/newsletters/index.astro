---
import BaseLayout from '~/layouts/BaseLayout.astro';
import {
  getPublishedNewsletters,
  formatShortDate,
  groupByYear,
} from '~/lib/newsletters';
import { withBase } from '~/lib/url';

const all = await getPublishedNewsletters();
const byYear = groupByYear(all);
---

<BaseLayout
  title="Newsletters"
  description="Every newsletter update, from the most recent back to the beginning."
>
  <h1>Newsletters</h1>
  <p style="color: var(--text-soft); max-width: var(--measure)">
    Every update we have sent out, newest first. {all.length}
    {all.length === 1 ? 'issue' : 'issues'} so far.
  </p>

  {
    byYear.length === 0 ? (
      <div class="empty" style="margin-top: 2rem">
        <p><strong>Nothing here yet.</strong></p>
        <p>The first newsletter will appear on this page once it is published.</p>
      </div>
    ) : (
      byYear.map(([year, entries]) => (
        <section>
          <h2 class="year-heading">{year}</h2>
          <ul class="issue-list">
            {entries.map((entry) => (
              <li class="issue">
                <span class="issue__date">{formatShortDate(entry.data.date)}</span>
                <div>
                  <h3 class="issue__title">
                    <a href={withBase(`/newsletters/${entry.id}`)}>{entry.data.title}</a>
                  </h3>
                  <p class="issue__summary">{entry.data.summary}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    )
  }
</BaseLayout>
