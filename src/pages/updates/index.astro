---
import BaseLayout from '~/layouts/BaseLayout.astro';
import {
  getPublishedUpdates,
  formatShortDate,
  groupByYear,
} from '~/lib/updates';
import { withBase } from '~/lib/url';

const all = await getPublishedUpdates();
const byYear = groupByYear(all);
---

<BaseLayout
  title="Updates"
  description="Every update, from the most recent back to the beginning."
>
  <div class="column">
    <h1>Updates</h1>
    <p style="color: var(--text-soft); max-width: var(--measure)">
      The updates and prayer requests from my time in ministry.
    </p>

    {
      byYear.length === 0 ? (
        <div class="empty" style="margin-top: 2rem">
          <p><strong>Nothing here yet.</strong></p>
          <p>The first update will appear on this page once it is published.</p>
        </div>
      ) : (
        byYear.map(([year, entries]) => (
          <section>
            <h2 class="year-heading">{year}</h2>
            <ul class="issue-list">
              {entries.map((entry) => (
                <li class="issue">
                  <span class="issue__date">{formatShortDate(entry.data.date)}</span>
                  <div>
                    <h3 class="issue__title">
                      <a href={withBase(`/updates/${entry.id}`)}>{entry.data.title}</a>
                    </h3>
                    <p class="issue__summary">{entry.data.summary}</p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
  </div>
</BaseLayout>
