---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Signature from '~/components/Signature.astro';
import { getPublishedUpdates, formatDate } from '~/lib/updates';
import { withBase } from '~/lib/url';

export const getStaticPaths = (async () => {
  const entries = await getPublishedUpdates();

  // Entries are newest first, so the "previous" issue is the next one along.
  return entries.map((entry, index) => ({
    params: { id: entry.id },
    props: {
      entry,
      newer: entries[index - 1],
      older: entries[index + 1],
    },
  }));
}) satisfies GetStaticPaths;

const { entry, newer, older } = Astro.props;
const { title, date, summary, cover, coverAlt, coverCaption, tags } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title} description={summary} image={cover?.src} type="article">
  <article class="article">
    <header class="article__header">
      <p class="article__date">{formatDate(date)}</p>
      <h1>{title}</h1>
      <p class="article__summary">{summary}</p>

      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      cover && (
        <figure class="article__cover">
          {/* The cover is displayed at up to --measure-wide (880px), so the
              largest sizes here cover 2x and 3x screens. `sizes` has to mirror
              the CSS or the browser guesses the full viewport width. */}
          <Image
            src={cover}
            alt={coverAlt ?? ''}
            width={1760}
            widths={[640, 880, 1320, 1760, 2200]}
            sizes="(max-width: 920px) calc(100vw - 2.5rem), 880px"
            loading="eager"
          />
          {coverCaption && <figcaption>{coverCaption}</figcaption>}
        </figure>
      )
    }

    <div class="prose">
      <Content />
      <Signature />
    </div>

    {
      (newer || older) && (
        <nav class="issue-nav" aria-label="More updates">
          {older ? (
            <a href={withBase(`/updates/${older.id}`)}>
              <span class="issue-nav__label">Previous update</span>
              <span class="issue-nav__title">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )}

          {newer && (
            <a class="issue-nav__next" href={withBase(`/updates/${newer.id}`)}>
              <span class="issue-nav__label">Next update</span>
              <span class="issue-nav__title">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
